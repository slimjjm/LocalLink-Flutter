{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "locallink-995a5",
          "appId": "1:126981571024:android:8b89de9bad8e4e6ebd39d5",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "locallink-995a5",
          "appId": "1:126981571024:ios:bdd17ecadbdd6895bd39d5",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "locallink-995a5",
          "appId": "1:126981571024:ios:bdd17ecadbdd6895bd39d5",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "locallink-995a5",
          "configurations": {
            "android": "1:126981571024:android:8b89de9bad8e4e6ebd39d5",
            "ios": "1:126981571024:ios:bdd17ecadbdd6895bd39d5",
            "macos": "1:126981571024:ios:bdd17ecadbdd6895bd39d5",
            "web": "1:126981571024:web:00af2a484a11a76abd39d5",
            "windows": "1:126981571024:web:3d04edc90f989c28bd39d5"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "site": "locallink-995a5",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "**/.DS_Store"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
