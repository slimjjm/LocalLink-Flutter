# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
lib/config/app_secrets.dart
ios/Flutter/StripeLive.xcconfig

# Local deployment caches (keep firebase.json and wrangler.toml tracked).
/.firebase/
/.wrangler/

# Native build output and Xcode intermediate caches.
/android/build/
/ios/build/
/macos/build/
/linux/build/
/windows/build/
**/XCBuildData/
**/PIFCache/
**/DerivedData/
**/.gradle/

# Downloaded JavaScript dependencies; retain package manifests and lockfiles.
node_modules/

# Local release binaries and private signing material.
*.ipa
*.aab
*.apk
*.xcarchive/
*.dSYM/
*.dSYM.zip
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile

# Local environment values and temporary files; retain example templates.
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
*.tmp
*.temp
*~
